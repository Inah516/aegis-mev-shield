# Xiaomi MiMo Token Plan endpoint
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro

# Chain WebSocket endpoints (mempool stream)
ETH_WS=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_WS=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ARB_WS=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
OP_WS=wss://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Storage
DB_URL=sqlite+aiosqlite:///./data/aegis.db

# Server
PORT=8000
LOG_LEVEL=INFO

# Detection thresholds
MIN_VICTIM_USD=500
SANDWICH_PROFIT_FLOOR_USD=20
JIT_FEE_FLOOR_USD=10
